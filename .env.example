# Copy to .env and adjust. .env is gitignored; this file is not.

# Postgres connection used by the asyncpg pool.
DATABASE_URL=postgresql://relay:relay@localhost:5432/relay

# Seconds the dispatcher sleeps between polls for due deliveries.
POLL_INTERVAL=1

# 1 compresses the retry schedule to seconds for local testing.
FAST_RETRY=0

# Secret the built-in test receiver (/sink) verifies incoming signatures with.
# Register /sink as a subscriber, then paste the secret that call returns here:
#   curl -X POST localhost:8000/endpoints -H 'Content-Type: application/json' \
#     -d '{"url": "http://localhost:8000/sink"}'
SINK_SECRET=whsec_replace_with_the_secret_returned_by_POST_/endpoints
